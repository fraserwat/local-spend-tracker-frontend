# Copy to .env and fill in real values. Never commit .env.

# Django settings module to use: config.settings.dev or config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Comma-separated, required in prod (e.g. spend.example.org)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Local dev: docker-compose's postgres service (default below).
# Prod: Neon connection string (postgresql://... -- django-environ accepts
# both postgres:// and postgresql://).
DATABASE_URL=postgres://spend_tracker:spend_tracker@localhost:5432/spend_tracker

# Path to the sibling local-big-con-nationwide checkout, for local ETL runs
DATA_REPO_PATH=../local-big-con-nationwide

# Cloudflare R2 (read-only token) -- curated parquet + manifests published
# nightly by the sibling local-big-con-nationwide repo. See docs/ARCHITECTURE.md.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
